--- !u!114 &1860151737
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1860151735}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4070d1a6750b0134b85ca66734792495, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeliveryRun
  van: {fileID: 1869662320}
  stops:
  - objective: Deliver the parcel - Mrs. Okafor, No. 14
    bay: {fileID: 1895041564}
    bayRadius: 13
    customer: {fileID: 1623104716}
    customerAnimator: {fileID: 142064971}
    arriveLine: Number 14. Mrs. Okafor's already out on the step. She always is.
    handOverLines: 'Mrs. Okafor: There he is. You look like death, love.|Mrs. Okafor:
      Your brother did my street on Thursday. Kept looking over his shoulder the
      whole time.|Mrs. Okafor: I asked him what was wrong. He said, ''Nothing I can
      fix.''|...Derek never tells me anything.|Mrs. Okafor: Go home. Make him talk
      to you.'
  - objective: Deliver the cool box - Harlow Clinic, back entrance
    bay: {fileID: 1689813643}
    bayRadius: 13
    customer: {fileID: 1033469080}
    customerAnimator: {fileID: 1353890769}
    arriveLine: The cool box. 'KEEP COLD - DO NOT OPEN.' Kessler's handwriting. Same
      back door every Saturday.
    handOverLines: 'Man at the door: You''re late. Kessler said half six.|Man at
      the door: No paperwork. No names. Same as always.|...What''s actually in these
      boxes?|Man at the door: Spare parts. You drive, you get your bonus, you don''t
      ask. That''s the deal.|He takes it and shuts the door in my face.|...Spare
      parts.'
  depotBay: {fileID: 1905668078}
  depotRadius: 2.6
  depotObjective: Park the van in the Kessler & Vane garage
  afterSpawn: {fileID: 71914369}
  beacon: {fileID: 371812315}
  objective: {fileID: 252663851}
  titleCard: {fileID: 560138419}
  fader: {fileID: 297356536}
  startLines: Two drops left on the sheet. Then the depot, then bed.|Twelve hours
    on the road for Kessler & Vane. My back's killing me.
  depotLines: Van's back in the garage.|Office lights are off. Door's locked. At
    this hour? Kessler's never late.|Keys through the mail slot. They land in the
    tray on my desk, like every Saturday.
  clockOutCard: 7:12 AM
