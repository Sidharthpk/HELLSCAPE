    ambience: {fileID: 0}
    ambienceVolume: 0.5
    sounds:
    - name: Start pressed
      note: 'Hit when you press START (built-in: a low thud). Title music = this
        area''s Music (built-in: a drone).'
      clips:
      - {fileID: 8300000, guid: af7950687aaf6dd4d9e05e309232e234, type: 3}
      volume: 1
  - name: Prologue
    music: {fileID: 0}
    musicVolume: 0.6
    ambience: {fileID: 0}
    ambienceVolume: 0.5
    sounds:
    - name: Heartbeat
      note: 'Heartbeat under the prologue from the open flat door onwards (now: WakeHeartbeat).'
      clips:
      - {fileID: 8300000, guid: 18c03eddad57f0346806f3bcc915c181, type: 3}
      volume: 1
    - name: Sting (body, spotted)
      note: 'Stinger when you find Derek and when you spot the killer (now: TitleSting).'
      clips:
      - {fileID: 8300000, guid: 02ce3e023f831e84281d0e9fc5386181, type: 3}
      volume: 1
    - name: Stabbing on the tape
      note: 'The stabbing on the CCTV tape (now: the stabbing sound effect).'
      clips:
      - {fileID: 8300000, guid: 0413bc46f8aacb04c8367105b75c9ae0, type: 3}
      volume: 1
    - name: Street ambience
      note: 'The morning street outside the flats (now: New York City Streets Ambience).'
      clips:
      - {fileID: 8300000, guid: 39076266763ce9c44a2abfe307cd800e, type: 3}
      volume: 1
    - name: TV murmur
      note: 'The TV murmuring in the living room (built-in: generated murmur).'
      clips:
      - {fileID: 8300000, guid: ef35ffc3fb482284d8d4bbebebb31ba4, type: 3}
      volume: 1
