--- !u!114 &1592781274
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1592781271}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65f27eeb84e620841b41716250897d8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GhostNPC
  ghostName: Ben
  nodes:
  - line: We got him a cake, you know. For his last shift. Nobody came.
    choices:
    - text: Whose last shift?
      reply: 'Ben: Tomas. The cleaner. He was going home to his brother.'
      next: 1
      karma: 0
    - text: I didn't know there was a cake.
      reply: 'Ben: No. You never looked up from your screen.'
      next: 1
      karma: 0
    - text: I don't have time for this.
      reply: 'Ben: Nobody ever had time for him either.'
      next: -1
      karma: -1
  - line: The date's still on the calendar. Kessler used it for everything after.
      Doors. Passwords. Guilt.
    choices:
    - text: What date?
      reply: 'Ben: The day he died. Day first, then the month. Look at the calendar.'
      next: -1
      karma: 0
    - text: We should have gone to his party.
      reply: 'Ben: ...yeah. We should have.|Ben: It''s on the calendar. Kessler''s
        door still remembers the day.'
      next: -1
      karma: 1
  afterLine: 'Ben: The calendar. Day first, then the month.'
  onFinished:
    m_PersistentCalls:
      m_Calls: []
  body: {fileID: 313568156}
  animator: {fileID: 313568157}
