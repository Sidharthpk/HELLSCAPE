  m_Script: {fileID: 11500000, guid: 65f27eeb84e620841b41716250897d8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GhostNPC
  ghostName: Nadia
  nodes:
  - line: Your desk is still there. He left something on it for you.
    choices:
    - text: What did he leave?
      reply: 'Nadia: A note. It''s on your desk. Don''t touch the red part.'
      next: -1
      karma: 0
    - text: Nadia, what happened here?
      reply: 'Nadia: He came at six, while you were still out on the road. Lights
        off, one by one.'
      next: 1
      karma: 0
  - line: Kessler locked himself in his office. It didn't save him.
    choices:
    - text: How do I get in there?
      reply: 'Nadia: Kessler''s code. Ask Ben what day it was.'
      next: -1
      karma: 0
    - text: Did anyone make it out?
      reply: 'Nadia: Maya and Sam ran for the silo.|Nadia: Please. Get them out.'
      next: -1
      karma: 1
    - text: Serves Kessler right.
      reply: 'Nadia: ...he was scared. We all were. You too.'
      next: -1
      karma: -1
  afterLine: 'Nadia: Maya and Sam. The silo. Get them out.'
  onFinished:
    m_PersistentCalls:
      m_Calls: []
