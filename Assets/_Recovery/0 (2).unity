  m_Script: {fileID: 11500000, guid: 65f27eeb84e620841b41716250897d8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GhostNPC
  ghostName: Kessler
  nodes:
  - line: Don't look at me like that. I kept this company alive.
    choices:
    - text: You made us sign a lie.
      reply: 'Kessler: I made you comfortable. You signed without reading. That''s
        on you.'
      next: 1
      karma: 0
    - text: What did Tomas see?
      reply: 'Kessler: Nothing. He saw nothing. He fell.|Kessler: It''s all in the
        report. The one you signed.'
      next: 1
      karma: -1
    - text: Open your door, Kessler.
      reply: 'Kessler: The code is the day it stopped mattering. Figure it out.'
      next: 1
      karma: 0
    - text: It's not too late to tell the truth.
      reply: 'Kessler: ...it is for me. Maybe not for you.'
      next: 1
      karma: 1
  - line: He's waiting in the silo. He wants everyone who signed.
    choices:
    - text: Then I'll face him.
      reply: 'Kessler: Brave. Or stupid.|Kessler: The silo key stays in my safe.
        Nobody goes down there.'
      next: -1
      karma: 0
    - text: You deserved what you got.
      reply: 'Kessler: ...maybe. So do you.'
      next: -1
      karma: -1
    - text: Help me get the others out.
      reply: 'Kessler: Maya and Sam ran for the silo.|Kessler: ...I''m sorry about
        Derek. He was a good worker.'
      next: -1
      karma: 1
  afterLine: 'Kessler: My safe stays shut. Whatever you think you know... prove it.'
  onFinished:
    m_PersistentCalls:
      m_Calls: []
  body: {fileID: 362628819}
  animator: {fileID: 362628818}
  hoverHeight: 0
  bobHeight: 0
  bobSpeed: 1.3
  driftRadius: 1.6
  driftSpeed: 0.55
  walkClipSpeed: 1.3
  holdRange: 3.5
  alphaRange: {x: 0.18, y: 0.45}
  whisperRange: 12
