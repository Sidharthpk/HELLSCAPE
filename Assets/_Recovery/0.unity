--- !u!114 &2141926216
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2141926213}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65f27eeb84e620841b41716250897d8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GhostNPC
  ghostName: Kessler
  nodes:
  - line: Don't look at me like that. I kept this company alive.
    choices:
    - text: You made us sign a lie.
      reply: 'Kessler: I made you comfortable. You signed without reading. That''s
        on you.'
      next: 1
      karma: 0
    - text: What did Tomas see?
      reply: 'Kessler: The silo paid your salaries. Not the freight. The silo.|Kessler:
        The cleaner saw the night trucks. I gave Derek a choice: him, or all of us.
        Derek chose.'
      next: 1
      karma: -1
    - text: Open the shutter, Kessler.
      reply: 'Kessler: The code is the day it stopped mattering. Figure it out.'
      next: 1
      karma: 0
    - text: It's not too late to tell the truth.
      reply: 'Kessler: ...it is for me. Maybe not for you.'
      next: 1
      karma: 1
  - line: He's waiting in the silo. He wants everyone who signed.
    choices:
    - text: Then I'll face him.
      reply: 'Kessler: Brave. Or stupid.|Kessler: The silo key is in my safe. The
        CCTV opens it.'
      next: -1
      karma: 0
    - text: You deserved what you got.
      reply: 'Kessler: ...maybe. So do you.'
      next: -1
      karma: -1
    - text: Help me get the others out.
      reply: 'Kessler: Maya, Derek, Sam - they ran for the silo.|Kessler: The key
        is in my safe. The CCTV opens it.'
      next: -1
      karma: 1
  afterLine: 'Kessler: The key''s in my safe. The tape opens it.'
  body: {fileID: 1143335738}
  animator: {fileID: 1143335739}
  hoverHeight: 0
  bobHeight: 0
  bobSpeed: 1.3
  driftRadius: 1.6
  driftSpeed: 0.55
  walkClipSpeed: 1.3
  holdRange: 3.5
  alphaRange: {x: 0.18, y: 0.45}
  whisperRange: 12
