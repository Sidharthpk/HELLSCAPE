  m_Script: {fileID: 11500000, guid: a8fbe01c4175af04e8fc19c9c4bcddb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SiloEncounter
  player: {fileID: 392070928}
  movement: {fileID: 392070927}
  health: {fileID: 392070935}
  gun: {fileID: 436781906}
  fader: {fileID: 829797400}
  siloCenter: {fileID: 770298386}
  throwDistance: 2.8
  throwLift: 1.5
  killer: {fileID: 145749344}
  killerLandPoint: {fileID: 1657752006}
  derekDeath: {fileID: 943677805}
  sfx: {fileID: 233966320}
  thudClip: {fileID: 0}
  gunProp: {fileID: 1590714889}
  gunThrowFrom: {fileID: 1513915058}
  bossAutoStart: 8
  choicePanel: {fileID: 558842159}
  keysPickup: {fileID: 1364845626}
  flood: {fileID: 233966318}
  pushLine: ...footsteps. Right behind me.
  landLine: Agh... my leg... I can't feel my leg...
  derekDeathLine: 'Derek...|Killer: Kessler gave the order. You held the knife.|Killer:
    Kessler''s already paid. Now you.'
  throwLine: 'Maya (on the stairs): HEY! Down there! Take it - CATCH!'
  gunLine: Security's rifle. Okay. Okay.
  defeatedLine: 'He drops to his knees. The mask is cracked down the middle.|Killer:
    Go on. Finish it. You people are good at that.'
  killLine: ...|There's a visitor badge in his coat. ELIAS ROURKE.|Clipped to it,
    a photo of the night cleaner. TOMAS ROURKE. 'My little brother.'
  spareLine: 'Elias: ...you''d let me live? After everything?|Elias: My brother Tomas
    cleaned your floors for six years. Nobody knew his name.|Elias: One night he
    saw the trucks Kessler ran through Silo 2. That''s all. He saw them.|Elias: Kessler
    made Derek shut him up, then they threw him in the silo like rubbish.|Elias:
    And every one of you signed it away as an accident.'
  keysLine: My car keys. He had them the whole time.
  confessionLine: 'Maya (on the stairs): We knew. Tomas caught Kessler at the silo
    that night - trucks, crates, cash. Nothing on any manifest.|Maya (on the stairs):
    Kessler told Derek to deal with him or go down with him. Derek did it. Then they
    threw Tomas into Silo 2.|Maya (on the stairs): Kessler made us all sign it off
    as an accident. All of us. YOU too.|...I signed that report without even reading
    it.|Is that why he came for my sister?'
  floodLine: The grates... that's blood. It's filling up.|SWIM!
  onLanded:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 670389632}
        m_TargetAssemblyTypeName: Checkpoint, Assembly-CSharp
