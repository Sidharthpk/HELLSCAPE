--- !u!114 &1815185325
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1815185322}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65f27eeb84e620841b41716250897d8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GhostNPC
  ghostName: Tomas
  nodes:
  - line: You. You signed on the last line. You didn't even read it.
    choices:
    - text: I'm sorry, Tomas. I should have read it.
      reply: 'Tomas: ...I believe you. My brother won''t.'
      next: 1
      karma: 1
    - text: It wasn't my fault.
      reply: 'Tomas: It''s never anyone''s fault. That''s how I stayed down there
        for three days.'
      next: 1
      karma: -1
    - text: Who did this to you?
      reply: 'Tomas: Derek held the knife. Kessler held Derek.|Tomas: I only saw
        the trucks. That''s all I ever did. I saw them.'
      next: 1
      karma: 0
  - line: Elias won't stop. Not until the silo is full.
    choices:
    - text: Can I stop him?
      reply: 'Tomas: You can end him... or you can end it. Those aren''t the same
        thing.'
      next: -1
      karma: 0
    - text: Then I'll get the others out first.
      reply: 'Tomas: Then go. Before the blood comes.'
      next: -1
      karma: 1
  afterLine: 'Tomas: Go. Before the blood comes.'
  body: {fileID: 1040912309}
  animator: {fileID: 1040912310}
  hoverHeight: 0
  bobHeight: 0
  bobSpeed: 1.3
