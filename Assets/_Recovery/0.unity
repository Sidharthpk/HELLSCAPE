--- !u!114 &927043163
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 927043160}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65f27eeb84e620841b41716250897d8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GhostNPC
  ghostName: Omar
  nodes:
  - line: I worked security. I watched the tape the night it happened. Then Kessler
      wiped it... mostly.
    choices:
    - text: What did you see?
      reply: 'Omar: Trucks at Silo 2 at three in the morning. No lights, no paperwork.
        Kessler counting cash.|Omar: And Tomas on the walkway with his mop. Watching.'
      next: 1
      karma: 0
    - text: You let him cover it up?
      reply: 'Omar: I needed the job. So did you.'
      next: 1
      karma: 0
    - text: Is there a copy?
      reply: 'Omar: The terminal in his wing still has the replay. Four cameras.'
      next: 1
      karma: 0
  - line: Tomas walked the same route every night. The tape only plays back if you
      follow him.
    choices:
    - text: What was his route?
      reply: 'Omar: It''s on the cleaning rota in reception. Put the times in order.'
      next: -1
      karma: 0
    - text: Rest now, Omar. I'll finish it.
      reply: 'Omar: ...the rota in reception. Earliest first. The silo last. Always
        the silo last.'
      next: -1
      karma: 1
  afterLine: 'Omar: Reception. Meeting room. Closet. Silo. Always the silo last.'
  body: {fileID: 220216094}
  animator: {fileID: 220216095}
  hoverHeight: 0
  bobHeight: 0
  bobSpeed: 1.3
  driftRadius: 1.6
  driftSpeed: 0.55
  walkClipSpeed: 1.3
  holdRange: 3.5
  alphaRange: {x: 0.18, y: 0.45}
  whisperRange: 12
