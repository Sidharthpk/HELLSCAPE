  airBar: {fileID: 1581423714}
  airFill: {fileID: 1252429545}
  airFillImage: {fileID: 1252429546}
  underTint: {fileID: 1414670728}
  health: {fileID: 392070935}
  firstLine: It's up to my chest-- KICK. Keep kicking!
  lowLine: 'Maya: Don''t stop! KICK!'
  survivorHead: 1.45
  survivorGrip: 1.5
  clingLine: 'Maya: We came down the stairs-- we can''t swim in this! Don''t let
    us go under!'
  mayaDrownLine: 'Maya: I can''t-- I can''t hold--|No-- MAYA!'
  samDrownLine: 'Sam: Help me-- please--|SAM!'
  ghostMaterial: {fileID: 2100000, guid: 57dd503422a2a214b9956bf233c8ccf8, type: 2}
  lostController: {fileID: 9100000, guid: b3f455fe8447c0745897dadb1028c1a5, type: 2}
  risenDamned: {fileID: 1332163256}
  cutscene: {fileID: 968035059}
  lostLine: He's up there. Over the blood. Blue, like the others in the city...|Sam's
    one of the Lost now. Because of me.
  damnedLine: Something's dragging itself out of the blood.|...Maya? She confessed
    down there. She said it out loud...|...and the city TOOK her.
  rumble: {fileID: 968035056}
  sfx: {fileID: 0}
  onBegin:
    m_PersistentCalls:
