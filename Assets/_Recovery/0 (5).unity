MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1155995259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 307d54b5198846745a08bcb6a11b9810, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KesslerConfrontation
  ghost: {fileID: 1348491182}
  confrontNodes:
  - line: You watched the tape. I can see it on your face.
    choices:
    - text: You made my brother a murderer.
      reply: 'Kessler: I made your brother RICH. There''s a difference.'
      next: 1
      karma: 0
    - text: What was really in those trucks?
      reply: 'Kessler: ...you want to know? Fine. You''ve earned it.'
      next: 1
      karma: 0
    - text: Tomas had a brother too, Kessler.
      reply: 'Kessler: Everybody has a brother.'
      next: 1
      karma: 1
  - line: The morgue sent us the ones nobody claimed. Before they went into Silo
      2, we took what sells. Kidneys. Livers. Eyes.|The silo crushed what was left.
      Tomas opened the wrong truck.
    choices:
    - text: Say it. Say you killed him.
      reply: 'Kessler: FINE! I killed him! Derek held the knife, but it was ME!'
      next: -1
      karma: 0
    - text: You're a monster.
      reply: 'Kessler: I''m a businessman. You cashed the bonuses. You never asked
        where they came from.'
      next: -1
      karma: 0
    - text: Why Derek? Why my brother?
      reply: 'Kessler: Because he needed the money. You both did. And he did what
        he was told.'
      next: -1
      karma: 0
