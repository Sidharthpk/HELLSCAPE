  m_Script: {fileID: 11500000, guid: a8fbe01c4175af04e8fc19c9c4bcddb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SiloEncounter
  player: {fileID: 392070928}
  movement: {fileID: 392070927}
  health: {fileID: 392070935}
  gun: {fileID: 436781898}
  fader: {fileID: 829797400}
  siloCenter: {fileID: 83538037}
  throwDistance: 2.8
  throwLift: 1.5
  killer: {fileID: 2143736379}
  killerLandPoint: {fileID: 1401917360}
  derekDeath: {fileID: 0}
  sfx: {fileID: 968035057}
  thudClip: {fileID: 0}
  gunProp: {fileID: 271648774}
  gunThrowFrom: {fileID: 1358331870}
  bossAutoStart: 8
  choicePanel: {fileID: 327759062}
  keysPickup: {fileID: 871646147}
  flood: {fileID: 968035055}
  pushLine: ...footsteps. Right behind me.
  landLine: Agh... my leg... I can't feel my leg...
  derekDeathLine: 'Elias: You pushed me off a roof. We fell together. Did you think
    that would stop me?|Elias: Kessler gave the order. Your brother held the knife.
    I took Derek. Kessler''s already paid.|Elias: Your name''s the last one on the
    report. Now YOU.'
  throwLine: 'Maya (on the stairs): HEY! Down there! Take it - CATCH!'
  gunLine: Security's rifle. Okay. Okay.
  defeatedLine: 'He drops to his knees, blood running down his face.|Elias: Go on.
    Finish it. You people are good at that.'
  killLine: ...|There's a visitor badge in his coat. ELIAS ROURKE.|Clipped to it,
    a photo of the night cleaner. TOMAS ROURKE. 'My little brother.'|...he was doing
    what I'd have done for Derek.
  spareLine: 'Elias: ...you''d let me live? After everything?|Elias: My brother Tomas
    cleaned your floors for six years. Nobody knew his name.|Elias: One night he
    opened one of the trucks Kessler ran through Silo 2. That''s all. He looked.|Elias:
    Kessler made Derek shut him up, then they threw him in the silo like rubbish.|Elias:
    And every one of you signed it away as an accident.'
  keysLine: My car keys. He had them the whole time.
  confessionLine: 'Maya (on the stairs): So you know now. The morgue trucks. What
    Kessler sold.|Maya (on the stairs): We all took the bonuses. We all signed his
    report. Nobody asked.|Maya (on the stairs): I''m sorry about Derek. He hated
    himself for it, every day after.|...I signed it without even reading it.|That''s
    why he came for us. For Derek. For me.'
  floodLine: The grates... that's blood. It's filling up.|SWIM!
  onLanded:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 969224534}
        m_TargetAssemblyTypeName: Checkpoint, Assembly-CSharp
        m_MethodName: Activate
        m_Mode: 1
