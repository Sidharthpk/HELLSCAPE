  ghostName: Vane
  nodes:
  - line: This is an Echo of the living office. The dead outside cannot reach me
      here.
    choices:
    - text: Elias said he killed you.
      reply: 'Vane: Six-oh-five. In the service tunnel. Death doesn''t mean I''ll
        submit to judgement.'
      next: -1
      karma: 0
      fate: 0
    - text: Why wasn't Kessler at the depot?
      reply: 'Vane: Listen to the phone if you want his answer. Then leave me alone.'
      next: -1
      karma: 0
      fate: 0
    - text: What happened to Tomas?
      reply: 'Vane: The security terminal. Four cameras. Find the order on the cleaning
        rota.'
      next: -1
      karma: 0
      fate: 0
  afterLine: 'Vane: Watch your tape. I won''t say what you want me to say.'
