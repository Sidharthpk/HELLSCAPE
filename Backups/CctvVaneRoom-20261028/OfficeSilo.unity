--- !u!114 &243061845
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 243061842}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65f27eeb84e620841b41716250897d8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GhostNPC
  fate: 0
  answerSeconds: 0
  ghostName: Omar
  nodes:
  - line: I worked security. I watched the tape the night it happened. Then Vane
      wiped it... mostly.
    choices:
    - text: What did you see?
      reply: 'Omar: Trucks from the city morgue at Silo 2, three in the morning.
        No lights, no paperwork. Cool boxes going out the other way.|Omar: And Tomas
        on the walkway with his mop. Watching.'
      next: 1
      karma: 0
      fate: 0
    - text: You let him cover it up?
      reply: 'Omar: I needed the job. So did you.'
      next: 1
      karma: 0
      fate: 0
    - text: Is there a copy?
      reply: 'Omar: The security terminal in Vane''s wing still has the replay. Four
        cameras.'
      next: 1
      karma: 0
      fate: 0
  - line: Tomas walked the same route every night. The tape only plays back if you
      follow him.
    choices:
    - text: What was his route?
      reply: 'Omar: It''s on the cleaning rota in reception. Put his times in order,
        earliest first.'
      next: -1
      karma: 0
      fate: 0
    - text: Rest now, Omar. I'll finish it.
      reply: 'Omar: ...the rota in reception. Earliest first. The silo last. Always
        the silo last.'
      next: -1
      karma: 1
      fate: 0
  afterLine: 'Omar: Reception. Meeting room. Closet. Silo. Always the silo last.'
  onFinished:
    m_PersistentCalls:
      m_Calls: []
