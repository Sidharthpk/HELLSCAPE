  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KesslerConfrontation
  ghost: {fileID: 1348491182}
  confrontNodes:
  - line: You brought that mark into my hiding place. Keep it away from me.
    choices:
    - text: The tape shows Derek killing Tomas.
      reply: 'Vane: He caught the cleaner opening our body bags. I told him both
        brothers would go down. Their van carried the dead.'
      next: 1
      karma: 0
      fate: 0
    - text: The Harlow manifest carries your code.
      reply: 'Vane: A signature isn''t a confession. I kept the business alive.'
      next: 1
      karma: 0
      fate: 0
  - line: Derek did what he was told. You all cashed the bonuses.
    choices:
    - text: You ordered it. Stop justifying it.
      reply: 'Vane: I protected our jobs. I WOULD DO IT AGAIN!'
      next: -1
      karma: 0
      fate: 0
    - text: You called Kessler at five. He abandoned you.
      reply: 'Vane: He''ll see I was right. I don''t need to confess to cross that
        bridge!'
      next: -1
      karma: 0
      fate: 0
