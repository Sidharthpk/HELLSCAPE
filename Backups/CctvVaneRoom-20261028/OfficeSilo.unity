  m_text: '<size=95%><cspace=0.08em><color=#9EA6B2>ON FOOT</color></cspace></size>

    <color=#FFCC5C>W
    A S D</color><pos=34%>Move

    <color=#FFCC5C>SHIFT</color><pos=34%>Sprint

    <color=#FFCC5C>SPACE</color><pos=34%>Jump

    <color=#FFCC5C>F</color><pos=34%>Use
    / talk / pick up

    <color=#FFCC5C>E</color><pos=34%>Next line

    <color=#FFCC5C>LEFT
    MOUSE</color><pos=34%>Punch / shoot

    <color=#FFCC5C>R</color><pos=34%>Reload

    <size=40%>

    </size><size=95%><cspace=0.08em><color=#9EA6B2>IN
    THE VAN</color></cspace></size>

    <color=#FFCC5C>W / S</color><pos=34%>Drive
    / reverse

    <color=#FFCC5C>A / D</color><pos=34%>Steer

    <color=#FFCC5C>SPACE</color><pos=34%>Handbrake

    <color=#FFCC5C>F</color><pos=34%>Get
    in / out

    <color=#FFCC5C>RIGHT MOUSE</color><pos=34%>Lean out and aim

    <color=#FFCC5C>MIDDLE
    MOUSE</color><pos=34%>Lock on

    <color=#FFCC5C>T (hold)</color><pos=34%>Put
    the van back on the road

'
