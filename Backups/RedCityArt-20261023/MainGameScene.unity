  endTrackVolume: 0.8
  walkerSpeed: 0.33
  walkAwayTime: 16
  besideTime: 2.5
  markedSkin: {fileID: 2800000, guid: ec5997dd739aa9c48973522766c89190, type: 3}
  handsFov: 42
  deathLines: 'The Demon King: You hit that street and you died, driver.|The Demon
    King: Not every soul is mine to take. Some I mark and send back to work.|The
    Demon King: Wear my mark. It will carry you into the world of the living, too.'
  deathBrandLine: My hands... the Sign of Judgement, burned into both of them.
  standPoint: {fileID: 443216951}
  maxFov: 85
  headRoom: 1
  arriveLine: The bridge. Judgement, not escape.|The mark is beating harder. The
    King is coming.
