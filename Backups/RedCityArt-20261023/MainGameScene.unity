  boundLine: Kessler is alive. The King can't see him.|I can reach the living through
    the Echo.|Behind me, Tomas is still hunting the last name on his list.
  sinkTime: 5
  walker: {fileID: 1294526757}
  cursed: {fileID: 440535327}
  cursedSpeed: 0.55
  cursedShot: 7
  hurtsAt: 2.6
  titleCard: {fileID: 892668674}
